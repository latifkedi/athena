---
import Base from '../layouts/Base.astro';
import type { Lang, NodeData } from '../lib/data';
import { allNodes, topLevel } from '../lib/data';
import { ui, t, url, nodePath, formatDate } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const dated = allNodes.filter((n) => n.date).sort((a, b) => a.date!.year - b.date!.year || (a.date!.month ?? 0) - (b.date!.month ?? 0));
const undated = allNodes
  .filter((n) => !n.date && n.datings.length)
  .sort((a, b) => t(a.title, lang).localeCompare(t(b.title, lang), lang));

const eras: { label: { tr: string; en: string }; test: (y: number) => boolean }[] = [
  { label: { tr: 'Milattan önce', en: 'Before the Common Era' }, test: (y) => y < 0 },
  { label: { tr: '1–1500', en: '1–1500' }, test: (y) => y >= 0 && y < 1500 },
  { label: { tr: '1500–1800', en: '1500–1800' }, test: (y) => y >= 1500 && y < 1800 },
  { label: { tr: '1800–1900', en: '1800–1900' }, test: (y) => y >= 1800 && y < 1900 },
  { label: { tr: '1900–2000', en: '1900–2000' }, test: (y) => y >= 1900 && y < 2000 },
  { label: { tr: '2000 ve sonrası', en: '2000 onwards' }, test: (y) => y >= 2000 },
];
const groups = eras
  .map((e) => ({ label: e.label, items: dated.filter((n) => e.test(n.date!.year)) }))
  .filter((g) => g.items.length);
const branchOf = (n: NodeData) => topLevel(n.id);
---

<Base lang={lang} title={t(ui.nav.timeline, lang)} route="timeline">
  <main class="wrap">
    <h1>{t(ui.nav.timeline, lang)}</h1>
    <p class="muted">
      {
        lang === 'tr'
          ? 'Yalnızca tarihi belgelenmiş olaylar (yayın, deney, gözlem) tarihleriyle gösterilir. Tarihi tartışmalı olanlar en altta ayrıca listelenir.'
          : 'Only events with a documented date (publication, experiment, observation) are placed on the timeline. Items whose dates are disputed are listed separately at the bottom.'
      }
    </p>

    {
      groups.map((g) => (
        <section>
          <h2>{t(g.label, lang)}</h2>
          <ol class="tl">
            {g.items.map((n) => {
              const b = branchOf(n);
              return (
                <li>
                  <span class="when">{formatDate(n.date, lang)}</span>
                  <span class={`dot ${n.side}`} />
                  <div>
                    <a href={url(nodePath(n.id, lang))}>{t(n.title, lang)}</a>
                    {b && b.id !== n.id && <span class="muted small"> · {t(b.title, lang)}</span>}
                    <p class="small muted">{t(n.summary, lang)}</p>
                  </div>
                </li>
              );
            })}
          </ol>
        </section>
      ))
    }

    {
      undated.length > 0 && (
        <section>
          <h2>{t(ui.undated, lang)}</h2>
          <p class="muted small">{t(ui.undatedNote, lang)}</p>
          <ul class="und">
            {undated.map((n) => (
              <li>
                <span class={`dot ${n.side}`} /> <a href={url(nodePath(n.id, lang) + '#datings')}>{t(n.title, lang)}</a>
                <span class="muted small">
                  {' '}
                  — {n.datings.map((d) => t(d.view, lang)).join(' · ')}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</Base>

<style>
  .tl {
    list-style: none;
    padding: 0;
    margin: 0;
    position: relative;
  }
  .tl::before {
    content: '';
    position: absolute;
    left: 125px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--border), var(--border-strong), var(--border));
  }
  .tl li {
    display: grid;
    grid-template-columns: 110px 12px 1fr;
    gap: 14px;
    align-items: baseline;
    padding: 10px 0;
  }
  .tl .when {
    font-family: var(--serif);
    font-variant-numeric: lining-nums;
    font-size: 1rem;
    color: var(--text-2);
    text-align: right;
  }
  .tl .dot {
    width: 12px;
    height: 12px;
    position: relative;
    top: 1px;
    box-shadow: 0 0 0 4px var(--surface);
  }
  .tl li > div {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 12px 16px;
    box-shadow: var(--shadow-sm);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .tl li > div:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }
  .tl a {
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
  }
  .tl a:hover {
    color: var(--accent-ink);
  }
  .tl p {
    margin: 4px 0 0;
    line-height: 1.6;
  }
  .und {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .und li {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 14px;
  }
  .und a {
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .und a:hover {
    color: var(--accent-ink);
  }
  @media (max-width: 560px) {
    .tl::before {
      left: 5px;
    }
    .tl li {
      grid-template-columns: 12px 1fr;
      gap: 6px 12px;
    }
    .tl .when {
      grid-column: 2;
      text-align: left;
      order: -1;
    }
    .tl .dot {
      grid-row: 1;
      grid-column: 1;
    }
  }
</style>
