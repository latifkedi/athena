---
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/data';
import { getNode, treeGroups } from '../lib/data';
import { feed, splitPapers } from '../lib/feed';
import { ui, t, url, nodePath, REPO } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// same order as on the tree, so related branches follow each other
const order = [...treeGroups('canopy'), ...treeGroups('roots')].flatMap((g) => g.fields);
const branches = Object.entries(feed.branches)
  .filter(([id, papers]) => getNode(id) && papers.length)
  .sort((a, b) => order.indexOf(a[0]) - order.indexOf(b[0]));
---

<Base lang={lang} title={t(ui.nav.latest, lang)} route="latest">
  <main class="wrap">
    <h1>{t(ui.nav.latest, lang)}</h1>
    {
      lang === 'tr' ? (
        <p class="muted">
          Bu liste her ay otomatik olarak güncellenir ve git geçmişinde saklanır. <strong>Hakemli dergi makaleleri</strong>{' '}
          <a href="https://openalex.org">OpenAlex</a>'ten alınır: Crossref, PubMed, DOAJ, arXiv, üniversite arşivleri ve
          yayıncı verilerini birleştiren açık akademik dizin (Google Scholar'ın bir programlama arayüzü olmadığı için onun
          açık karşılığı kullanılır). Her alan için son iki ayda yayımlanıp en çok atıf alan makaleler listelenir.{' '}
          <strong>Türkçe yayınlar</strong> yine OpenAlex'ten, Türkçe yazılmış dergi makalelerinden (DergiPark'taki
          dergilerin çoğu dahil) son bir yılın en çok atıf alanlarıdır.{' '}
          <strong>Ön baskılar</strong> arXiv, bioRxiv, medRxiv, ChemRxiv, PsyArXiv ve SocArXiv'den alınır; henüz hakem
          değerlendirmesinden geçmemiş olabilirler. Öne çıkan çalışmalar incelendikten sonra ağaca düğüm olarak eklenir.
        </p>
      ) : (
        <p class="muted">
          This list is refreshed automatically every month and kept in the git history. <strong>Peer-reviewed articles</strong>{' '}
          come from <a href="https://openalex.org">OpenAlex</a>, the open scholarly index that combines Crossref, PubMed,
          DOAJ, arXiv, university repositories and publisher data (used as the open counterpart to Google Scholar, which
          has no API). For every field it lists the most-cited articles of the last two months.{' '}
          <strong>Turkish-language papers</strong> also come from OpenAlex: the most-cited journal articles written in
          Turkish (including most DergiPark journals) over the past year.{' '}
          <strong>Preprints</strong> come from arXiv, bioRxiv, medRxiv, ChemRxiv, PsyArXiv and SocArXiv and may not be
          peer-reviewed yet. Notable work is added to the tree as a node after review.
        </p>
      )
    }
    {
      feed.generated ? (
        <p class="small muted">
          {t(ui.lastUpdate, lang)}: {feed.generated.slice(0, 10)}
        </p>
      ) : (
        <p class="card">
          {lang === 'tr' ? (
            <>
              İlk otomatik güncelleme henüz çalışmadı. GitHub'daki{' '}
              <a href={`${REPO}/actions`}>Actions</a> sekmesinden “Deploy” iş akışını elle çalıştırarak hemen
              başlatabilirsiniz; sonra her ayın 1'inde kendiliğinden çalışır.
            </>
          ) : (
            <>
              The first automatic update has not run yet. Run the “Deploy” workflow from the{' '}
              <a href={`${REPO}/actions`}>Actions</a> tab on GitHub to start it now; after that it runs on the 1st of
              every month.
            </>
          )}
        </p>
      )
    }

    {
      branches.map(([id, papers]) => {
        const n = getNode(id)!;
        const { journals, turkish, preprints } = splitPapers(papers);
        return (
          <section>
            <h2>
              <span class={`dot ${n.side}`} /> <a href={url(nodePath(id, lang))}>{t(n.title, lang)}</a>
            </h2>
            {[
              [ui.journalPapers, journals],
              [ui.turkishPapers, turkish],
              [ui.preprintPapers, preprints],
            ].map(
              ([label, list]) =>
                (list as typeof papers).length > 0 && (
                  <>
                    <h3>{t(label as typeof ui.journalPapers, lang)}</h3>
                    <ul class="papers">
                      {(list as typeof papers).map((p) => (
                        <li>
                          <a href={p.url} rel="noopener">
                            {p.title}
                          </a>
                          <div class="small muted">
                            {p.authors} · {p.date} · {p.source} {p.category}
                          </div>
                        </li>
                      ))}
                    </ul>
                  </>
                ),
            )}
          </section>
        );
      })
    }
  </main>
</Base>

<style>
  .papers {
    list-style: none;
    padding: 0;
    margin: 0 0 8px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .papers li {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    transition: background 0.12s;
  }
  .papers li:last-child {
    border-bottom: 0;
  }
  .papers li:hover {
    background: var(--surface-2);
  }
  .papers a {
    color: var(--text);
    font-weight: 550;
    text-decoration: none;
    line-height: 1.45;
  }
  .papers a:hover {
    color: var(--accent-ink);
    text-decoration: underline;
  }
  .papers .small {
    margin-top: 3px;
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
  }
</style>
