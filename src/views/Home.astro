---
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/data';
import { allNodes, centerNode, topLevel } from '../lib/data';
import { ui, t, url, nodePath, routes, typeLabels, formatDate } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const payload = {
  lang,
  center: centerNode.id,
  strings: {
    openPage: t(ui.openPage, lang),
    close: t(ui.close, lang),
    children: t(ui.children, lang),
    related: t(ui.related, lang),
    canopy: t(ui.canopyLabel, lang),
    roots: t(ui.rootsLabel, lang),
    datings: t(ui.datings, lang),
  },
  nodes: allNodes.map((n) => ({
    id: n.id,
    p: n.parent,
    s: n.side,
    k: n.children,
    ty: t(typeLabels[n.type], lang),
    t: t(n.title, lang),
    sum: t(n.summary, lang),
    d: n.date ? formatDate(n.date, lang) : '',
    dv: n.datings.length,
    href: url(nodePath(n.id, lang)),
    rel: n.related,
    top: n.depth >= 1 ? topLevel(n.id)?.id : null,
  })),
};
---

<Base lang={lang} route="home" bleed>
  <main class="tree-app">
    <div class="tree-toolbar">
      <div class="search">
        <label class="visually-hidden" for="tree-search">{t(ui.search, lang)}</label>
        <input id="tree-search" type="search" placeholder={t(ui.search, lang)} autocomplete="off" />
        <ul id="search-results" role="listbox" hidden></ul>
      </div>
      <div class="tb-buttons">
        <button class="btn" type="button" id="btn-expand">{t(ui.expandAll, lang)}</button>
        <button class="btn" type="button" id="btn-collapse">{t(ui.collapseAll, lang)}</button>
        <button class="btn" type="button" id="btn-fit">{t(ui.fit, lang)}</button>
      </div>
    </div>

    <div class="legend small">
      <span><span class="dot canopy"></span>{t(ui.canopyLabel, lang)}</span>
      <span><span class="dot roots"></span>{t(ui.rootsLabel, lang)}</span>
    </div>

    <svg id="tree" role="img" aria-label={t(ui.siteTagline, lang)}></svg>

    <noscript>
      <p class="noscript">
        {t(ui.noJs, lang)} <a href={url(routes.list[lang])}>{t(ui.nav.list, lang)}</a>
      </p>
    </noscript>

    <aside id="panel" class="panel" hidden aria-live="polite"></aside>

    <p class="principle-float small">{t(ui.principle, lang)}</p>
  </main>

  <script type="application/json" id="tree-data" set:html={JSON.stringify(payload)} />
</Base>

<script>
  import { initTree } from '../scripts/tree';
  initTree();
</script>

<style is:global>
  body.bleed {
    overflow: hidden;
  }
  .tree-app {
    position: relative;
    height: calc(100dvh - 57px);
    overflow: hidden;
  }
  #tree {
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
    cursor: grab;
  }
  #tree:active {
    cursor: grabbing;
  }
  .tree-toolbar {
    position: absolute;
    top: 12px;
    left: 16px;
    right: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    z-index: 5;
    pointer-events: none;
  }
  .tree-toolbar > * {
    pointer-events: auto;
  }
  .search {
    position: relative;
    flex: 1 1 220px;
    max-width: 340px;
  }
  .search input {
    width: 100%;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
  }
  #search-results {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
    max-height: 50vh;
    overflow: auto;
  }
  #search-results li {
    padding: 6px 8px;
    border-radius: 6px;
    cursor: pointer;
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 0.9rem;
  }
  #search-results li[aria-selected='true'],
  #search-results li:hover {
    background: var(--surface-2);
  }
  #search-results .hint {
    color: var(--text-3);
    font-size: 0.78rem;
    margin-left: auto;
    white-space: nowrap;
  }
  .tb-buttons {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .legend {
    position: absolute;
    left: 16px;
    bottom: 12px;
    z-index: 4;
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: var(--text-2);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    padding: 6px 10px;
    border-radius: 8px;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .principle-float {
    position: absolute;
    right: 16px;
    bottom: 12px;
    max-width: 420px;
    margin: 0;
    color: var(--text-3);
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    padding: 6px 10px;
    border-radius: 8px;
    z-index: 3;
  }
  .panel:not([hidden]) ~ .principle-float {
    display: none;
  }
  .noscript {
    position: absolute;
    top: 80px;
    left: 16px;
  }

  /* tree marks */
  .t-link {
    fill: none;
    stroke-width: 1.2;
    stroke-opacity: 0.55;
  }
  .t-link.canopy {
    stroke: var(--canopy);
  }
  .t-link.roots {
    stroke: var(--roots);
  }
  .t-link.d1 {
    stroke-width: 2.4;
  }
  .t-link.on {
    stroke: var(--accent);
    stroke-opacity: 1;
    stroke-width: 2.2;
  }
  .t-rel {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-dasharray: 4 4;
    stroke-opacity: 0.8;
  }
  .t-ground {
    stroke: var(--border);
    stroke-width: 1.2;
  }
  .t-side-label {
    fill: var(--text-3);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .t-node {
    cursor: pointer;
    outline: none;
  }
  .t-node .hit {
    fill: transparent;
  }
  .t-node .mark {
    stroke-width: 1.8;
  }
  .t-node.canopy .mark {
    fill: var(--canopy);
    stroke: var(--canopy);
  }
  .t-node.roots .mark {
    fill: var(--roots);
    stroke: var(--roots);
  }
  .t-node.center .mark {
    fill: var(--text);
    stroke: var(--surface);
    stroke-width: 3;
  }
  .t-node.open .mark {
    fill: var(--surface);
  }
  .t-node .ring {
    fill: none;
    stroke-width: 1.2;
    stroke-opacity: 0.5;
  }
  .t-node.canopy .ring {
    stroke: var(--canopy);
  }
  .t-node.roots .ring {
    stroke: var(--roots);
  }
  .t-node.sel .mark {
    stroke: var(--accent);
    stroke-width: 3;
  }
  .t-node:focus-visible .hit {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .t-node text {
    font-size: 12.5px;
    fill: var(--text);
    paint-order: stroke;
    stroke: var(--surface);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .t-node.d1 text {
    font-size: 14px;
    font-weight: 650;
  }
  .t-node.center text {
    font-size: 15px;
    font-weight: 700;
  }
  .t-node.dim text {
    fill: var(--text-2);
  }
  .t-node.sel text {
    fill: var(--accent-ink);
    font-weight: 700;
  }
  /* semantic zoom: when zoomed out, keep main-branch labels readable and
     show deeper labels only for the selection, its path and on hover */
  #tree.far .t-node.d1 text {
    font-size: calc(14px * min(1.2, max(1, 0.8 / var(--k, 1))));
  }
  #tree.far .t-node.center text {
    font-size: calc(15px * min(1.6, max(1, 0.8 / var(--k, 1))));
  }
  #tree.far .t-node:not(.d0):not(.d1):not(.lbl):not(.hov):not(:focus-visible) text {
    display: none;
  }
  #tree.far .t-node.lbl:not(.d1):not(.center) text,
  #tree.far .t-node.hov:not(.d1):not(.center) text {
    font-size: calc(12.5px * min(2, 0.8 / var(--k, 1)));
  }

  /* panel */
  .panel {
    position: absolute;
    top: 64px;
    right: 16px;
    bottom: 64px;
    width: min(380px, calc(100vw - 32px));
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.14);
    padding: 16px 18px;
    overflow: auto;
    z-index: 6;
  }
  .panel h2 {
    margin: 8px 0 4px;
    font-size: 1.25rem;
  }
  .panel .meta {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
  }
  .panel .close {
    position: absolute;
    top: 10px;
    right: 10px;
  }
  .panel p.sum {
    margin: 10px 0 14px;
  }
  .panel h3 {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-3);
    margin: 16px 0 6px;
  }
  .panel ul.links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .panel ul.links button {
    appearance: none;
    font: inherit;
    font-size: 0.82rem;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text);
    border-radius: 999px;
    padding: 3px 10px;
    cursor: pointer;
    text-align: left;
  }
  .panel ul.links button:hover {
    border-color: var(--accent);
  }
  .panel .go {
    display: inline-block;
    margin-top: 18px;
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .panel {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-height: 55dvh;
      border-radius: 16px 16px 0 0;
    }
    .principle-float {
      display: none;
    }
    .legend {
      bottom: 8px;
      left: 8px;
    }
  }
</style>
