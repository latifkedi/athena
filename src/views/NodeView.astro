---
import Base from '../layouts/Base.astro';
import Cite from '../components/Cite.astro';
import SourceList from '../components/SourceList.astro';
import type { Lang, NodeData } from '../lib/data';
import { ancestors, getNode, relatedTo, nodeSources, descendantCount, typedLinks, REL_KINDS } from '../lib/data';
import { personSlug, people } from '../lib/people';
import { journeysThrough } from '../lib/journeys';
import { canCompare } from '../lib/compare';
import { latestFor, splitPapers } from '../lib/feed';
import { literatureLinks } from '../lib/scholar';
import { datesOf } from '../lib/history';
import {
  ui,
  t,
  url,
  nodePath,
  routes,
  typeLabels,
  evidenceKinds,
  formatDate,
  suggestUrl,
  otherLang,
  REPO,
  personPath,
  journeyPath,
  comparePath,
  relLabels,
} from '../lib/i18n';

interface Props {
  node: NodeData;
  lang: Lang;
}
const { node, lang } = Astro.props;
const other = otherLang(lang);
const chain = ancestors(node.id);
const sources = nodeSources(node);
const index: Record<string, number> = {};
sources.forEach((s, i) => (index[s.key] = i + 1));
const children = node.children.map((id) => getNode(id)!);
const typed = typedLinks(node.id);
// typed links, grouped as "Builds on", "Built upon by", ... in a fixed order
const typedGroups = REL_KINDS.flatMap((rel) =>
  (['out', 'in'] as const)
    .map((dir) => ({ rel, dir, items: typed.filter((l) => l.rel === rel && l.dir === dir) }))
    .filter((g) => g.items.length),
);
const typedIds = new Set(typed.map((l) => l.node.id));
const relIds = new Set(
  [...node.related, ...relatedTo(node.id).map((n) => n.id)].filter((id) => !typedIds.has(id)),
);
const trips = journeysThrough(node.id);
const related = [...relIds].map((id) => getNode(id)).filter(Boolean) as NodeData[];
const evFor = node.evidence.filter((e) => e.stance === 'for');
const evAgainst = node.evidence.filter((e) => e.stance === 'against');
const papers = node.depth === 1 ? latestFor(node.id) : [];
const split = splitPapers(papers);
const journalPapers = split.journals.slice(0, 4);
const turkishPapers = split.turkish.slice(0, 4);
const preprints = split.preprints.slice(0, 4);
const lit = literatureLinks(node, lang);
const isFork = node.type === 'question' && (node.children.length > 0 || node.positions.length >= 2);
const title = t(node.title, lang);
const sideLabel = node.side === 'roots' ? t(ui.roots, lang) : node.side === 'canopy' ? t(ui.canopy, lang) : '';
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const para = (s: string) => esc(s.trim()).split(/\n\s*\n/).join('</p><p>');

// page history and a ready-made citation
const dates = datesOf(node.file);
const branch = chain.find((a) => a.depth === 1) ?? (node.depth === 1 ? node : undefined);
const pageUrl = (Astro.site?.toString().replace(/\/$/, '') ?? '') + url(nodePath(node.id, lang));
const year = (dates?.changed ?? new Date().toISOString()).slice(0, 4);
const today = new Date().toISOString().slice(0, 10);
const months = {
  tr: ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'],
  en: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
};
const human = (d?: string) => {
  if (!d) return '';
  const [y, m, dd] = d.split('-').map(Number);
  return lang === 'tr' ? `${dd} ${months.tr[m - 1]} ${y}` : `${months.en[m - 1]} ${dd}, ${y}`;
};
const siteName = lang === 'tr' ? 'Athena: İnsanlığın bilgi ağacı' : 'Athena: The tree of human knowledge';
const apa =
  lang === 'tr'
    ? `Athena katkıcıları. (${year}). ${title}. ${siteName}. Erişim: ${human(today)}, ${pageUrl}`
    : `Athena contributors. (${year}). ${title}. ${siteName}. Retrieved ${human(today)}, from ${pageUrl}`;
const bibtex = `@misc{athena_${node.id.replace(/-/g, '_')},
  title        = {${title}},
  author       = {{Athena ${lang === 'tr' ? 'katkıcıları' : 'contributors'}}},
  year         = {${year}},
  howpublished = {\\url{${pageUrl}}},
  note         = {${siteName}. ${lang === 'tr' ? 'Erişim' : 'Accessed'}: ${today}}
}`;
---

<Base
  lang={lang}
  title={title}
  description={t(node.summary, lang)}
  altPath={nodePath(node.id, other)}
  nodeId={node.id}
  nodeTitle={title}
  ogImage={`/og/${lang}/${node.id}.png`}
>
  <main class="wrap node" data-pagefind-body>
    {branch && <span hidden data-pagefind-filter={lang === 'tr' ? 'Dal' : 'Branch'}>{t(branch.title, lang)}</span>}
    <nav class="crumbs small" aria-label="breadcrumb" data-pagefind-ignore>
      {
        chain.map((a) => (
          <>
            <a href={url(nodePath(a.id, lang))}>{t(a.title, lang)}</a>
            <span aria-hidden="true">›</span>
          </>
        ))
      }
      <span>{title}</span>
    </nav>

    <div class="meta" data-pagefind-ignore>
      <span class="chip"><span class={`dot ${node.side}`}></span>{t(typeLabels[node.type], lang)}</span>
      {sideLabel && <span class="chip">{sideLabel}</span>}
      {node.date && <span class="chip">{formatDate(node.date, lang)}</span>}
      {node.datings.length > 0 && <a class="chip" href="#datings">{t(ui.datings, lang)}</a>}
      {node.children.length > 0 && <span class="chip">{descendantCount(node.id)} {t(ui.nodes, lang)}</span>}
    </div>

    <h1 data-pagefind-meta="title">{title}</h1>
    {
      node.people.length > 0 && (
        <p class="people muted">
          {node.people.map((p, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={url(personPath(personSlug(p), lang))}>{t(people.get(personSlug(p))?.name, lang) || p}</a>
            </>
          ))}
        </p>
      )
    }
    {
      !['center', 'field'].includes(node.type) && (
        <p class="note small" data-pagefind-ignore>
          <span aria-hidden="true">ⓘ</span> {t(ui.nodeNote, lang)}{' '}
          <a href={url(routes.method[lang])}>{t(ui.nav.method, lang)}</a>
        </p>
      )
    }

    {
      isFork && (
        <p class="fork-box">
          <strong>⑂ {t(ui.forkBox, lang)}.</strong>{' '}
          {t(node.children.length ? ui.forkNoteKids : ui.forkNote, lang)}
          {canCompare(node) && (
            <>
              {' '}
              <a class="compare-link" href={url(comparePath(node.id, lang))}>
                {t(ui.compare, lang)} →
              </a>
            </>
          )}
        </p>
      )
    }

    <section class="levels">
      <div class="level">
        <h2>{t(ui.forEveryone, lang)}</h2>
        <p set:html={para(t(node.summary, lang))} />
      </div>
      {
        node.technical && (
          <div class="level expert">
            <h2>{t(ui.forExperts, lang)}</h2>
            <p set:html={para(t(node.technical, lang))} />
          </div>
        )
      }
    </section>

    {
      node.datings.length > 0 && (
        <section id="datings">
          <h2>{t(ui.datings, lang)}</h2>
          <p class="muted small">{t(ui.datingsNote, lang)}</p>
          <table class="datings">
            <tbody>
              {node.datings.map((d) => (
                <tr>
                  <th scope="row">{t(d.view, lang)}</th>
                  <td>
                    {t(d.value, lang)}
                    <Cite keys={d.src} index={index} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      node.claims.length > 0 && (
        <section>
          <h2>{t(ui.claims, lang)}</h2>
          <ul class="claims">
            {node.claims.map((c) => (
              <li>
                {t(c, lang)}
                <Cite keys={c.src} index={index} />
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      node.evidence.length > 0 && (
        <section>
          <h2>{t(ui.evidence, lang)}</h2>
          <div class="evidence">
            <div class="col for">
              <h3>{t(ui.evFor, lang)}</h3>
              {evFor.length === 0 && <p class="muted small">—</p>}
              {evFor.map((e) => (
                <div class="ev">
                  <span class="kind">{t(evidenceKinds[e.kind] ?? { tr: e.kind, en: e.kind }, lang)}</span>
                  <p>
                    {t(e, lang)}
                    <Cite keys={e.src} index={index} />
                  </p>
                </div>
              ))}
            </div>
            <div class="col against">
              <h3>{t(ui.evAgainst, lang)}</h3>
              {evAgainst.length === 0 && <p class="muted small">—</p>}
              {evAgainst.map((e) => (
                <div class="ev">
                  <span class="kind">{t(evidenceKinds[e.kind] ?? { tr: e.kind, en: e.kind }, lang)}</span>
                  <p>
                    {t(e, lang)}
                    <Cite keys={e.src} index={index} />
                  </p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    {
      node.positions.length > 0 && (
        <section>
          <h2>{t(ui.positions, lang)}</h2>
          <dl class="positions">
            {node.positions.map((p) => (
              <div>
                <dt>{t(p.who, lang)}</dt>
                <dd>
                  {t(p, lang)}
                  <Cite keys={p.src} index={index} />
                </dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      node.open.length > 0 && (
        <section>
          <h2>{t(ui.open, lang)}</h2>
          <ul>
            {node.open.map((o) => (
              <li>{t(o, lang)}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section data-pagefind-ignore>
      <h2>{t(ui.connections, lang)}</h2>
      <div class="conn">
        {
          chain.length > 0 && (
            <div>
              <h3>{t(ui.parentLabel, lang)}</h3>
              <a class="chip" href={url(nodePath(chain[chain.length - 1].id, lang))}>
                <span class={`dot ${chain[chain.length - 1].side}`} />
                {t(chain[chain.length - 1].title, lang)}
              </a>
            </div>
          )
        }
        {
          children.length > 0 && (
            <div>
              <h3>{t(ui.children, lang)}</h3>
              <div class="chips">
                {children.map((c) => (
                  <a class="chip" href={url(nodePath(c.id, lang))}>
                    <span class={`dot ${c.side}`} />
                    {t(c.title, lang)}
                  </a>
                ))}
              </div>
            </div>
          )
        }
        {typedGroups.map((g) => (
          <div>
            <h3>{t(relLabels[g.rel][g.dir], lang)}</h3>
            <div class="chips">
              {g.items.map((l) => (
                <a class={`chip rel ${g.rel}`} href={url(nodePath(l.node.id, lang))} title={l.note ? t(l.note, lang) : undefined}>
                  <span class={`dot ${l.node.side}`} />
                  {t(l.node.title, lang)}
                </a>
              ))}
            </div>
          </div>
        ))}
        {
          related.length > 0 && (
            <div>
              <h3>{t(ui.related, lang)}</h3>
              <div class="chips">
                {related.map((c) => (
                  <a class="chip" href={url(nodePath(c.id, lang))}>
                    <span class={`dot ${c.side}`} />
                    {t(c.title, lang)}
                  </a>
                ))}
              </div>
            </div>
          )
        }
        {
          trips.length > 0 && (
            <div>
              <h3>{t(ui.inJourneys, lang)}</h3>
              <div class="chips">
                {trips.map(({ journey, step }) => (
                  <a class="chip journey" href={url(journeyPath(journey.id, lang)) + `#durak-${step}`}>
                    {t(journey.title, lang)}
                    <span class="muted">
                      {' '}
                      · {t(ui.stop, lang).toLocaleLowerCase(lang)} {step}/{journey.steps.length}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        }
        <p class="small">
          <a href={url(routes.home[lang]) + '#' + node.id}>{lang === 'tr' ? 'Ağaçta göster →' : 'Show in tree →'}</a>
        </p>
      </div>
    </section>

    {
      papers.length > 0 && (
        <section data-pagefind-ignore>
          <h2>{t(ui.latestInBranch, lang)}</h2>
          {[
            [ui.journalPapers, journalPapers],
            [ui.turkishPapers, turkishPapers],
            [ui.preprintPapers, preprints],
          ].map(
            ([label, list]) =>
              (list as typeof papers).length > 0 && (
                <>
                  <h3>{t(label as typeof ui.journalPapers, lang)}</h3>
                  <ul class="papers">
                    {(list as typeof papers).map((p) => (
                      <li>
                        <a href={p.url} rel="noopener">
                          {p.title}
                        </a>
                        <span class="muted small">
                          {' '}
                          — {p.authors} · {p.date} · {p.source}
                        </span>
                      </li>
                    ))}
                  </ul>
                </>
              ),
          )}
          <p class="small">
            <a href={url(routes.latest[lang])}>{t(ui.nav.latest, lang)} →</a>
          </p>
        </section>
      )
    }

    <section id="sources">
      <h2>{t(ui.sources, lang)}</h2>
      <SourceList sources={sources} lang={lang} />
    </section>

    {
      lit.length > 0 && (
        <section class="lit" data-pagefind-ignore>
          <h2>{t(ui.literature, lang)}</h2>
          <p class="muted small">{t(ui.literatureNote, lang)}</p>
          <div class="chips">
            {lit.map((l) => (
              <a class="chip" href={l.href} rel="noopener">
                {l.label} ↗
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="cite" data-pagefind-ignore>
      <h2>{t(ui.cite, lang)}</h2>
      <div class="cite-box">
        <div class="cite-row">
          <span class="cite-label">APA</span>
          <p class="cite-text" id="cite-apa">{apa}</p>
          <button class="btn copy" type="button" data-copy="cite-apa" data-done={t(ui.copied, lang)}>{t(ui.copy, lang)}</button>
        </div>
        <div class="cite-row">
          <span class="cite-label">BibTeX</span>
          <pre class="cite-text" id="cite-bib">{bibtex}</pre>
          <button class="btn copy" type="button" data-copy="cite-bib" data-done={t(ui.copied, lang)}>{t(ui.copy, lang)}</button>
        </div>
      </div>
      {
        dates && (
          <p class="small muted page-dates">
            {t(ui.added, lang)}: {human(dates.created)} · {t(ui.lastChanged, lang)}: {human(dates.changed)} ·{' '}
            <a href={`${REPO}/commits/HEAD/${node.file}`}>{t(ui.history, lang)}</a>
          </p>
        )
      }
    </section>

    <p class="suggest" data-pagefind-ignore>
      <a class="btn" href={suggestUrl(lang, node.id, title)}>✎ {t(ui.suggest, lang)}</a>
    </p>
  </main>
</Base>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('button.copy')) {
    b.addEventListener('click', async () => {
      const el = document.getElementById(b.dataset.copy!);
      if (!el) return;
      try {
        await navigator.clipboard.writeText(el.textContent ?? '');
        const old = b.textContent;
        b.textContent = b.dataset.done ?? '✓';
        setTimeout(() => (b.textContent = old), 1600);
      } catch {
        getSelection()?.selectAllChildren(el);
      }
    });
  }
</script>

<style>
  .cite-box {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .cite-row {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 12px;
    align-items: start;
    padding: 14px 16px;
  }
  .cite-row + .cite-row {
    border-top: 1px solid var(--border);
  }
  .cite-label {
    font-size: 0.7rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    padding-top: 3px;
  }
  .cite-text {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-2);
    line-height: 1.55;
    word-break: break-word;
  }
  pre.cite-text {
    font-family: var(--mono);
    font-size: 0.8rem;
    white-space: pre-wrap;
  }
  .page-dates {
    margin-top: 12px;
  }
  @media (max-width: 560px) {
    .cite-row {
      grid-template-columns: 1fr auto;
    }
    .cite-label {
      grid-column: 1 / -1;
    }
  }
  .node {
    padding-top: 28px;
  }
  .crumbs {
    color: var(--text-3);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.85rem;
  }
  .crumbs a {
    color: var(--text-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--text);
    text-decoration: underline;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 18px 0 6px;
  }
  a.chip {
    text-decoration: none;
    transition: border-color 0.15s;
  }
  a.chip:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  h1 {
    margin-bottom: 0.25em;
  }
  .people a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, currentColor 30%, transparent);
  }
  .people a:hover {
    color: var(--accent-ink);
    border-bottom-color: currentColor;
  }
  .compare-link {
    font-weight: 600;
    color: var(--fork);
    white-space: nowrap;
  }
  .chip.journey {
    border-style: dashed;
  }
  .people {
    margin: 0 0 6px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--text-2);
  }
  .note {
    color: var(--text-3);
    margin: 10px 0 26px;
  }
  .fork-box {
    border: 1px solid color-mix(in srgb, var(--fork) 30%, var(--border));
    border-left: 3px solid var(--fork);
    background: color-mix(in srgb, var(--fork) 6%, var(--card));
    padding: 12px 16px;
    border-radius: 4px var(--radius-sm) var(--radius-sm) 4px;
    font-size: 0.93rem;
    color: var(--text-2);
    margin: 0 0 24px;
  }
  .fork-box strong {
    color: var(--fork);
  }
  .levels {
    display: grid;
    gap: 22px;
    margin-top: 8px;
  }
  .level h2 {
    font-family: var(--font);
    font-size: 0.75rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-3);
    margin: 0 0 8px;
  }
  .level p {
    margin: 0;
  }
  .level:not(.expert) p {
    font-size: 1.14rem;
    line-height: 1.75;
  }
  .level:not(.expert) p + p {
    margin-top: 0.9em;
  }
  .level.expert {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
    box-shadow: var(--shadow-sm);
  }
  .level.expert p {
    font-size: 0.97rem;
    line-height: 1.7;
    color: var(--text-2);
  }
  table.datings {
    border-collapse: separate;
    border-spacing: 0;
    width: 100%;
    font-size: 0.95rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  table.datings th,
  table.datings td {
    text-align: left;
    vertical-align: top;
    padding: 12px 16px;
  }
  table.datings tr + tr th,
  table.datings tr + tr td {
    border-top: 1px solid var(--border);
  }
  table.datings th {
    width: 34%;
    font-weight: 600;
    background: var(--surface-2);
  }
  .claims {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .claims li {
    position: relative;
    padding-left: 22px;
  }
  .claims li::before {
    content: '';
    position: absolute;
    left: 3px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    transform: rotate(45deg);
    background: var(--bark);
    opacity: 0.7;
  }
  .evidence {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .col {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px 6px;
    box-shadow: var(--shadow-sm);
    position: relative;
    overflow: hidden;
  }
  .col::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--border);
  }
  .col.for::before {
    background: var(--for);
  }
  .col.against::before {
    background: var(--against);
  }
  .evidence h3 {
    margin: 2px 0 12px;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .col.for h3 {
    color: var(--for);
  }
  .col.against h3 {
    color: var(--against);
  }
  .ev {
    padding: 0 0 12px;
    margin-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .ev:last-child {
    border-bottom: 0;
    margin-bottom: 0;
  }
  .ev p {
    margin: 4px 0 0;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .kind {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-3);
    background: var(--surface-2);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .positions {
    display: grid;
