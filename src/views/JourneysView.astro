---
import Base from '../layouts/Base.astro';
import type { Lang } from '../lib/data';
import { getNode } from '../lib/data';
import { journeys } from '../lib/journeys';
import { ui, t, url, journeyPath, yearLabel } from '../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const cards = journeys.map((j) => {
  const stops = j.steps.map((s) => getNode(s.node)!);
  const years = stops.map((n) => n.date?.year).filter((y): y is number => y !== undefined);
  const span = years.length ? `${yearLabel(Math.min(...years), lang)} – ${yearLabel(Math.max(...years), lang)}` : '';
  return { j, stops, span };
});
---

<Base lang={lang} title={t(ui.nav.journeys, lang)} route="journeys">
  <main class="wrap">
    <h1>{t(ui.nav.journeys, lang)}</h1>
    <p class="lead muted">{t(ui.journeysIntro, lang)}</p>

    <ul class="journeys">
      {
        cards.map(({ j, stops, span }) => (
          <li>
            <a class="card" href={url(journeyPath(j.id, lang))}>
              <h2>{t(j.title, lang)}</h2>
              <p class="intro">{t(j.intro, lang)}</p>
              <div class="trail" aria-hidden="true">
                {stops.map((n) => (
                  <span class={`stop ${n.side}`} />
                ))}
              </div>
              <p class="small muted">
                {stops.length} {t(ui.stops, lang)}
                {span && <> · {span}</>}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .lead {
    max-width: 68ch;
    font-size: 1.02rem;
  }
  .journeys {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
  }
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 20px 22px 16px;
    color: var(--text);
    text-decoration: none;
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      transform 0.15s;
  }
  .card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }
  h2 {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 550;
    margin: 0 0 8px;
    border: 0;
    padding: 0;
  }
  h2::after {
    display: none;
  }
  .intro {
    color: var(--text-2);
    font-size: 0.93rem;
    line-height: 1.55;
    margin: 0 0 16px;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .trail {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 2px 10px;
  }
  .trail::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    border-radius: 2px;
    background: var(--border-strong);
  }
  .stop {
    position: relative;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--card);
    box-sizing: content-box;
  }
  .stop.canopy {
    background: var(--canopy);
  }
  .stop.roots {
    background: var(--roots);
  }
  .stop.center {
    background: var(--bark);
  }
  .card p.small {
    margin: 0;
  }
</style>
