---
import type { Lang, Source } from '../lib/data';
import { sourceLinks, archiveLink } from '../lib/data';
import { t, ui, sourceTypes } from '../lib/i18n';

interface Props {
  sources: Source[];
  lang: Lang;
}
const { sources, lang } = Astro.props;
---

<ol class="sources">
  {
    sources.map((s) => {
      const links = sourceLinks(s);
      const arch = archiveLink(s);
      return (
        <li id={`src-${s.key.replace('@', '_')}`}>
          <span class="stype">{t(sourceTypes[s.type] ?? { tr: s.type, en: s.type }, lang)}</span>
          {s.authors && <span class="authors">{s.authors}</span>}
          {s.year !== undefined && <span class="year"> ({s.year}). </span>}
          <cite>{s.title}</cite>
          {s.in && <span class="in">. {s.in}</span>}
          {s.isbn && <span class="isbn"> · ISBN {s.isbn}</span>}
          {s.note && <span class="note"> — {t(s.note, lang)}</span>}
          {(links.length > 0 || arch) && (
            <span class="links">
              {links.map((l) => (
                <a href={l.href} rel="noopener">
                  {l.label}
                </a>
              ))}
              {arch && (
                <a href={arch} rel="noopener" class="arch">
                  {t(ui.archive, lang)}
                </a>
              )}
            </span>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .sources {
    list-style: none;
    counter-reset: src;
    padding: 0;
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-2);
    display: grid;
    gap: 2px;
  }
  .sources li {
    counter-increment: src;
    position: relative;
    padding: 10px 12px 10px 42px;
    border-radius: 10px;
    line-height: 1.55;
    scroll-margin-top: 90px;
    transition: background 0.2s;
  }
  .sources li::before {
    content: counter(src);
    position: absolute;
    left: 10px;
    top: 10px;
    min-width: 22px;
    font-size: 0.78rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-3);
    text-align: right;
  }
  .sources li:hover {
    background: var(--surface-2);
  }
  .sources li:target {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .stype {
    display: inline-block;
    font-size: 0.66rem;
    font-weight: 650;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-3);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 7px;
    margin-right: 6px;
    vertical-align: 1px;
  }
  .authors {
    color: var(--text);
    font-weight: 500;
  }
  cite {
    font-style: italic;
    color: var(--text);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 4px;
  }
  .links a {
    font-size: 0.8rem;
    word-break: break-all;
  }
  .arch {
    color: var(--text-3);
  }
</style>
