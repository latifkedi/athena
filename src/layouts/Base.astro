---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces/soft.css';
import '@fontsource-variable/fraunces/soft-italic.css';
import '../styles/global.css';
import type { Lang } from '../lib/data';
import { ui, url, routes, t, otherLang, suggestUrl, REPO, type RouteKey } from '../lib/i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  route?: RouteKey;
  /** Path (without base) of the same page in the other language. */
  altPath?: string;
  bleed?: boolean;
  nodeId?: string;
  nodeTitle?: string;
}

const { lang, title, description, route, altPath, bleed = false, nodeId, nodeTitle } = Astro.props;
const other = otherLang(lang);
const alt = altPath ?? (route ? routes[route][other] : routes.home[other]);
const fullTitle = title ? `${title} · Athena` : `Athena — ${t(ui.siteTagline, lang)}`;
const desc = description ?? t(ui.siteTagline, lang);
const navKeys: RouteKey[] = ['home', 'list', 'timeline', 'dashboard', 'latest', 'method'];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" hreflang={other} href={url(alt)} />
    <script is:inline>
      try {
        const th = localStorage.getItem('athena-theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
  </head>
  <body class={bleed ? 'bleed' : ''}>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={url(routes.home[lang])} aria-label="Athena">
          <svg viewBox="0 0 32 32" aria-hidden="true">
            <path
              d="M16 17.5c-.9-3.6-3.1-6.2-6.6-7.5M16 17.5c.9-3.6 3.1-6.2 6.6-7.5M16 17.5V4.5M16 11c-1.6-1.9-3.6-3-5.8-3.3M16 11c1.6-1.9 3.6-3 5.8-3.3"
              fill="none"
              stroke="var(--canopy)"
              stroke-width="2.2"
              stroke-linecap="round"></path>
            <path
              d="M16 17.5v3.2M16 20.7c-1.2 2.5-3.3 4.2-6 5M16 20.7c1.2 2.5 3.3 4.2 6 5M16 20.7v7"
              fill="none"
              stroke="var(--roots)"
              stroke-width="2"
              stroke-linecap="round"></path>
            <path d="M5 19h22" stroke="var(--bark)" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
          <span>Athena</span>
        </a>
        <nav class="nav" aria-label={lang === 'tr' ? 'Ana menü' : 'Main menu'}>
          {
            navKeys.map((k) => (
              <a href={url(routes[k][lang])} aria-current={route === k ? 'page' : undefined}>
                {t(ui.nav[k], lang)}
              </a>
            ))
          }
        </nav>
        <div class="tools">
          <a class="btn" href={url(alt)} hreflang={other} lang={other} title={other === 'en' ? 'English' : 'Türkçe'}>
            {other.toUpperCase()}
          </a>
          <button class="btn" id="theme-btn" type="button" aria-label={t(ui.theme, lang)} title={t(ui.theme, lang)}>
            <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.39 5.39 0 0 1-4.4 2.26 5.4 5.4 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1z"
              ></path></svg
            >
          </button>
        </div>
      </div>
    </header>

    <slot />

    {
      !bleed && (
        <footer class="site-footer">
          <div class="wrap">
            <svg class="foot-mark" viewBox="0 0 32 32" aria-hidden="true">
              <path
                d="M16 17.5c-.9-3.6-3.1-6.2-6.6-7.5M16 17.5c.9-3.6 3.1-6.2 6.6-7.5M16 17.5V4.5M16 11c-1.6-1.9-3.6-3-5.8-3.3M16 11c1.6-1.9 3.6-3 5.8-3.3"
                fill="none"
                stroke="var(--canopy)"
                stroke-width="2"
                stroke-linecap="round"></path>
              <path
                d="M16 17.5v3.2M16 20.7c-1.2 2.5-3.3 4.2-6 5M16 20.7c1.2 2.5 3.3 4.2 6 5M16 20.7v7"
                fill="none"
                stroke="var(--roots)"
                stroke-width="1.8"
                stroke-linecap="round"></path>
              <path d="M5 19h22" stroke="var(--bark)" stroke-width="1.3" stroke-linecap="round"></path>
            </svg>
            <p class="principle">{t(ui.principle, lang)}</p>
            <p class="foot-links">
              <a href={suggestUrl(lang, nodeId, nodeTitle)}>{t(ui.suggest, lang)}</a>
              <a href={url(routes.method[lang])}>{t(ui.nav.method, lang)}</a>
              <a href={REPO}>GitHub</a>
            </p>
            <p class="small foot-license">
              {lang === 'tr' ? 'İçerik' : 'Content'}:{' '}
              <a href="https://creativecommons.org/licenses/by-sa/4.0/deed.tr" rel="license">CC BY-SA 4.0</a> ·{' '}
              {lang === 'tr' ? 'Kod' : 'Code'}: <a href={`${REPO}/blob/HEAD/LICENSE`}>MIT</a>
            </p>
          </div>
        </footer>
      )
    }

    <script is:inline>
      (function () {
        const btn = document.getElementById('theme-btn');
        if (!btn) return;
        btn.addEventListener('click', function () {
          const root = document.documentElement;
          const dark =
            root.dataset.theme === 'dark' ||
            (!root.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
          const next = dark ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('athena-theme', next);
          } catch (e) {}
          window.dispatchEvent(new CustomEvent('athena-theme'));
        });
      })();
    </script>
  </body>
</html>
